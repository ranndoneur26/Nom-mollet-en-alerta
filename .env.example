# Supabase — projecte de MOLLET EN ALERTA
# Obtén aquests valors a supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Només servidor. MAI exposar al client ni fer-la pública al repositori.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Correu transaccional (notificacions de canvi d'estat). Opcional a l'MVP.
RESEND_API_KEY=re_...
NOTIFICATIONS_FROM_EMAIL=notificacions@molletenalerta.example

# Protecció anti-spam del formulari (Cloudflare Turnstile). Opcional a l'MVP.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# URL pública del desplegament (usada en metadades / correus)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
